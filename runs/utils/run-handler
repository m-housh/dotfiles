#!/usr/bin/env bash

set -e
set -o nounset
set -o pipefail

THIS_FILE=${BASH_SOURCE[0]}
LOG_LABEL=${LOG_LABEL:-$(basename "$THIS_FILE")}
LOG_FILE=${LOG_FILE:-"$LOG_LABEL.log"}

declare manifest mode dry_run runs_dir comment_pattern
declare -a yayflags

usage() {
	printf 'Usage: run-handler MANIFEST {install|uninstall} {0|1}\n' >&2
}

fail() {
	printf 'run-handler: %s\n' "$*" >&2
	usage
	exit 2
}

log() {
	logging log --source "$THIS_FILE" --echo "$@"
}

run_before_or_after() {
	local dir=$1 hook
	hook=$dir/$(basename "$manifest")

	if [[ -x $hook && -f $hook ]]; then
		log "\trunning $(basename "$dir") script: '$hook'"
		if [[ $dry_run == "0" ]]; then
			# shellcheck disable=SC1090
			source "$hook" "$mode"
		fi
	fi
}

main() {
	local line pkg

	log "RUN: file: $manifest"
	log "${mode}ing packages from: $manifest"

	run_before_or_after "$runs_dir/before"

	# Process package entries in manifest order.
	while IFS= read -r line; do
		if [[ ! $line =~ $comment_pattern ]]; then
			pkg=${line%% \#*}
			if [[ -n $pkg ]]; then
				log "\tpkg: '$pkg'"
				if [[ $dry_run == "0" ]]; then
					yay "${yayflags[@]}" "$pkg"
				fi
			fi
		fi
	done <"$manifest"

	run_before_or_after "$runs_dir/after"
}

############################## MAIN ##############################

(($# == 3)) || fail "expected manifest, mode, and dry-run arguments"
manifest=$1
mode=$2
dry_run=$3

[[ $mode == "install" || $mode == "uninstall" ]] || fail "invalid mode: $mode"
[[ $dry_run == "0" || $dry_run == "1" ]] || fail "dry-run must be 0 or 1"
[[ -f $manifest && -r $manifest ]] || fail "manifest is not a readable regular file: $manifest"
[[ -n ${SCRIPTS:-} ]] || fail "env var SCRIPTS needs to be present"

runs_dir=$(dirname "$manifest")
# Read by the logging utility sourced below.
# shellcheck disable=SC2034
LOG_ENABLE_DRY_RUN=$dry_run
# shellcheck disable=SC1091
source "$SCRIPTS/hypr/logging"
setup-logging "$LOG_FILE" "$LOG_LABEL"

comment_pattern='^#'
yayflags=("-S" "--noconfirm" "--needed")
if [[ $mode == "uninstall" ]]; then
	yayflags=("-Rns")
fi

# Ensure yay is installed before proceeding with a real lifecycle.
if [[ $dry_run == "0" ]]; then
	# shellcheck disable=SC1090,SC1091
	source "$runs_dir/before/yay"
fi

main
