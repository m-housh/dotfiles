#!/usr/bin/env bash

# Copies this repository's configuration into a home directory. DEV_ENV remains
# explicit because the installed copy of this script is outside the repository.

set -Eeuo pipefail

DRY_RUN=0
RELOAD_SHELL=1
PROFILE=full
PROFILE_SET=0
DEV_ENV_ROOT=""

usage() {
	cat <<'EOF'
Usage: dev-env [full|container] [--dry-run] [--no-reload] [--help]

  full         Install the complete environment (the default).
  container    Install the minimal development-container environment.
  --dry-run    Print the complete installation plan without changing anything.
  --no-reload  Do not replace this process with a login Zsh after installation.
  --help       Show this help.

For full installations, directories directly below env/.config are replaced by
default. herdr, hypr, and nvim are merged; systemd and zsh have explicit
preservation policies; kanata is not installed automatically.
EOF
}

fail() {
	printf 'dev-env: %s\n' "$*" >&2
	exit 1
}

parse_args() {
	while (($#)); do
		case $1 in
		--dry-run) DRY_RUN=1 ;;
		--no-reload) RELOAD_SHELL=0 ;;
		--help)
			usage
			exit 0
			;;
		--*) fail "unknown option: $1 (try --help)" ;;
		full | container)
			((PROFILE_SET == 0)) || fail "multiple profiles specified: $PROFILE and $1"
			PROFILE=$1
			PROFILE_SET=1
			;;
		*) fail "unknown profile: $1 (try --help)" ;;
		esac
		shift
	done
}

print_command() {
	local prefix=""
	if ((DRY_RUN)); then
		prefix="[dry-run] "
	fi
	printf '%s' "$prefix"
	printf '%q ' "$@"
	printf '\n'
}

run() {
	print_command "$@"
	((DRY_RUN)) || command "$@"
}

run_capture() {
	local destination=$1 prefix=""
	shift
	if ((DRY_RUN)); then
		prefix="[dry-run] "
	fi
	printf '%s' "$prefix"
	printf '%q ' "$@"
	printf '> %q\n' "$destination"
	if ((DRY_RUN)); then
		return 0
	fi

	local temporary="${destination}.tmp.$$"
	if ! command "$@" >"$temporary"; then
		rm -f -- "$temporary"
		return 1
	fi
	command mv -f -- "$temporary" "$destination"
}

log_action() {
	if ((DRY_RUN)); then
		printf '[dry-run] %s\n' "$*"
	else
		printf '%s\n' "$*"
	fi
}

canonical_directory() {
	local path=$1
	[[ -d $path ]] || fail "directory does not exist: $path"
	(cd -- "$path" >/dev/null && pwd -P)
}

normalize_path() {
	realpath -m -- "$1"
}

source_exists() {
	[[ -e $1 || -L $1 ]] || fail "source does not exist: $1"
}

source_directory_exists() {
	[[ -d $1 ]] || fail "source directory does not exist: $1"
}

source_file_exists() {
	[[ -f $1 ]] || fail "source file does not exist or is not a regular file: $1"
}

source_real_directory_exists() {
	[[ -d $1 && ! -L $1 ]] || fail "source must be a real directory, not a symlink: $1"
}

source_real_file_exists() {
	[[ -f $1 && ! -L $1 ]] || fail "source must be a real regular file, not a symlink: $1"
}

validate_pi_skill_source() {
	local skill=$1 entry
	source_real_directory_exists "$skill"
	source_real_file_exists "$skill/SKILL.md"

	while IFS= read -r -d '' entry; do
		if [[ -L $entry ]]; then
			fail "unsupported symlink in managed Pi skill: $entry"
		fi
		[[ -d $entry || -f $entry ]] || fail "unsupported entry in managed Pi skill: $entry"
	done < <(find "$skill" -mindepth 1 -print0)
}

validate_destination() {
	local destination normalized root
	destination=$1
	[[ -n $destination && $destination == /* ]] || fail "unsafe destination: $destination"
	normalized=$(normalize_path "$destination")
	[[ $normalized != / ]] || fail "refusing destructive root destination: $destination"

	for root in "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME"; do
		root=$(normalize_path "$root")
		[[ $normalized != "$root" ]] || fail "refusing destination root: $destination"
		if [[ $normalized == "$root"/* ]]; then
			return 0
		fi
	done
	fail "destination is outside HOME/XDG roots: $destination"
}

replace_tree() {
	local source=$1 destination=$2
	source_directory_exists "$source"
	validate_destination "$destination"
	run rm -rf -- "$destination"
	run mkdir -p -- "$(dirname -- "$destination")"
	run cp -a -- "$source" "$destination"
}

merge_tree() {
	local source=$1 destination=$2
	source_directory_exists "$source"
	validate_destination "$destination"
	run mkdir -p -- "$destination"
	run cp -a -- "$source/." "$destination/"
}

replace_entry_sources() {
	local destination=$1 entry target
	shift
	validate_destination "$destination"
	run mkdir -p -- "$destination"

	for entry in "$@"; do
		target="$destination/${entry##*/}"
		validate_destination "$target"
		run rm -rf -- "$target"
		run cp -a -- "$entry" "$target"
	done
}

replace_entries() {
	local source=$1 destination=$2 entry
	local -a entries=()
	source_directory_exists "$source"

	# NUL delimiters preserve whitespace, glob characters, and newlines in names.
	while IFS= read -r -d '' entry; do
		entries+=("$entry")
	done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
	replace_entry_sources "$destination" "${entries[@]}"
}

copy_file() {
	local source=$1 destination=$2
	source_file_exists "$source"
	validate_destination "$destination"
	run mkdir -p -- "$(dirname -- "$destination")"
	run rm -rf -- "$destination"
	run cp -a -- "$source" "$destination"
}

install_pi_environment() {
	local source_root="$DEV_ENV_ROOT/env/.pi/agent"
	local destination_root="$HOME/.pi/agent"
	local source
	local -a managed_skills=() managed_themes=()

	# Discover and validate every managed source before mutating the runtime.
	source_real_file_exists "$source_root/AGENTS.md"
	source_real_file_exists "$source_root/settings.json"
	source_real_file_exists "$source_root/extensions/herdr-flow.ts"
	source_directory_exists "$source_root/skills"
	source_directory_exists "$source_root/themes"

	while IFS= read -r -d '' source; do
		managed_skills+=("$source")
	done < <(find "$source_root/skills" -mindepth 1 -maxdepth 1 -print0)
	while IFS= read -r -d '' source; do
		managed_themes+=("$source")
	done < <(find "$source_root/themes" -mindepth 1 -maxdepth 1 -print0)

	for source in "${managed_skills[@]}"; do
		validate_pi_skill_source "$source"
	done
	for source in "${managed_themes[@]}"; do
		source_real_file_exists "$source"
	done
	validate_destination "$destination_root"

	copy_file "$source_root/AGENTS.md" "$destination_root/AGENTS.md"
	copy_file "$source_root/extensions/herdr-flow.ts" "$destination_root/extensions/herdr-flow.ts"
	replace_entry_sources "$destination_root/skills" "${managed_skills[@]}"
	replace_entry_sources "$destination_root/themes" "${managed_themes[@]}"

	if [[ -e $destination_root/settings.json || -L $destination_root/settings.json ]]; then
		log_action "preserve existing Pi settings: $destination_root/settings.json"
	else
		copy_file "$source_root/settings.json" "$destination_root/settings.json"
	fi
}

install_config_directories() {
	local source name destination
	source_directory_exists "$DEV_ENV_ROOT/env/.config"
	while IFS= read -r -d '' source; do
		name=${source##*/}
		destination="$XDG_CONFIG_HOME/$name"
		case $name in
		herdr | hypr | nvim) merge_tree "$source" "$destination" ;;
		kanata | systemd | zsh) : ;;
		*) replace_tree "$source" "$destination" ;;
		esac
	done < <(find "$DEV_ENV_ROOT/env/.config" -mindepth 1 -maxdepth 1 -type d -print0)
}

install_explicit_mappings() {
	local index

	# MAPPINGS: FULL
	# Edit these arrays to change the full profile's explicit installations.
	# Config directories discovered automatically are handled above.
	local -a file_sources=(
		"env/.zshenv"
		"env/.tmux.conf"
		"env/.markdownlint.jsonc"
		"env/.prettierrc.json"
		"dev-env"
	)
	local -a file_destinations=(
		"$HOME/.zshenv"
		"$HOME/.tmux.conf"
		"$HOME/.markdownlint.jsonc"
		"$HOME/.prettierrc.json"
		"$HOME/.local/scripts/dev-env"
	)
	local -a merge_sources=(
		"env/.gnupg"
		"env/wallpapers"
		"env/.local/share/applications"
	)
	local -a merge_destinations=(
		"$HOME/.gnupg"
		"$HOME/wallpapers"
		"$XDG_DATA_HOME/applications"
	)
	local -a entry_sources=(
		"env/.local/scripts"
		"env/pkgbuilds"
	)
	local -a entry_destinations=(
		"$HOME/.local/scripts"
		"$HOME/pkgbuilds"
	)

	for index in "${!file_sources[@]}"; do
		copy_file "$DEV_ENV_ROOT/${file_sources[index]}" "${file_destinations[index]}"
	done
	for index in "${!merge_sources[@]}"; do
		merge_tree "$DEV_ENV_ROOT/${merge_sources[index]}" "${merge_destinations[index]}"
	done
	for index in "${!entry_sources[@]}"; do
		replace_entries "$DEV_ENV_ROOT/${entry_sources[index]}" "${entry_destinations[index]}"
	done

	merge_tree "$DEV_ENV_ROOT/env/.config/systemd/user" "$XDG_CONFIG_HOME/systemd/user"
	replace_entries "$DEV_ENV_ROOT/env/.config/zsh" "$XDG_CONFIG_HOME/zsh"

	run mkdir -p -- "$HOME/Pictures" "$XDG_DATA_HOME/clipse/tmp_files"
}

migrate_legacy_wt() {
	local legacy_wt="$HOME/.local/bin/wt" checksum
	[[ -e $legacy_wt || -L $legacy_wt ]] || return 0

	if [[ ! -f $legacy_wt || -L $legacy_wt ]]; then
		log_action "preserve unrecognized legacy wt path: $legacy_wt"
		return 0
	fi
	checksum=$(sha256sum -- "$legacy_wt")
	checksum=${checksum%% *}
	case $checksum in
	b01a1d6738b691b88b1a65d90629b3c9ee418bcb4eda71750ba6eca019bfb5a1 | \
	abca656e8179e5fcf1f28bbcab69f4a3e5cf9680108e274461ceb4167c676673 | \
	d41e89e6b3763038d7ba76bc769874990fa7bae466bbca6b95e71a29fd15965b | \
	a66353816dcfddec6db4ceb3fd911e205a1a1deaaa4b3c1158db0dc7e74e2173)
		validate_destination "$legacy_wt"
		run rm -f -- "$legacy_wt"
		;;
	*) log_action "preserve unrecognized legacy wt path: $legacy_wt" ;;
	esac
}

install_container_environment() {
	local index

	# MAPPINGS: CONTAINER
	# Edit this explicit manifest to change container installations.
	local -a config_names=(eza git ripgrep starship yazi)
	local -a file_sources=(
		"env/.markdownlint.jsonc"
		"env/.prettierrc.json"
		"env/.tmux.conf"
		"env/.zshenv"
	)
	local -a file_destinations=(
		"$HOME/.markdownlint.jsonc"
		"$HOME/.prettierrc.json"
		"$HOME/.tmux.conf"
		"$HOME/.zshenv"
	)

	for index in "${!config_names[@]}"; do
		replace_tree \
			"$DEV_ENV_ROOT/env/.config/${config_names[index]}" \
			"$XDG_CONFIG_HOME/${config_names[index]}"
	done
	replace_entries "$DEV_ENV_ROOT/env/.config/zsh" "$XDG_CONFIG_HOME/zsh"

	# Initialize exactly the commit recorded by this repository before copying it.
	run git -C "$DEV_ENV_ROOT" submodule update --init -- env/.config/nvim
	merge_tree "$DEV_ENV_ROOT/env/.config/nvim" "$XDG_CONFIG_HOME/nvim"

	for index in "${!file_sources[@]}"; do
		copy_file "$DEV_ENV_ROOT/${file_sources[index]}" "${file_destinations[index]}"
	done
	merge_tree "$DEV_ENV_ROOT/env/.local/scripts" "$HOME/.local/scripts"
}

generate_completions() {
	local completion_dir="$HOME/.zsh/completions"
	local wt_completion="$completion_dir/_wt"
	local herdr_flow_completion="$completion_dir/_herdr-flow"
	local hpa_completion="$completion_dir/_hpa"
	local hpa_environment="$HOME/.local/scripts/utils/hpa/hpa.env"

	run mkdir -p -- "$completion_dir"
	run_capture "$wt_completion" "$HOME/.local/scripts/wt" completion zsh
	run_capture "$herdr_flow_completion" "$HOME/.local/scripts/herdr-flow" completion zsh

	if ((DRY_RUN)); then
		log_action "generate HPA Zsh completion -> $hpa_completion"
		return 0
	fi

	source_exists "$hpa_environment"
	# shellcheck disable=SC1090
	. "$hpa_environment"
	: "${HPA_DOCKER_IMAGE:?HPA_DOCKER_IMAGE is not set by $hpa_environment}"
	: "${HPA_DOCKER_TAG:?HPA_DOCKER_TAG is not set by $hpa_environment}"
	run_capture "$hpa_completion" podman run --rm \
		"$HPA_DOCKER_IMAGE:$HPA_DOCKER_TAG" --generate-completion-script zsh
}

reload_services() {
	run systemctl --user daemon-reload
	run hyprctl reload
	run espanso service restart
}

install_full_environment() {
	install_pi_environment
	install_config_directories
	install_explicit_mappings
	migrate_legacy_wt
	generate_completions
	reload_services
}

reload_login_shell() {
	((RELOAD_SHELL)) || return 0
	print_command zsh -l
	((DRY_RUN)) || exec zsh -l
}

initialize_paths() {
	[[ -n ${HOME:-} ]] || fail "HOME is not set"
	[[ -n ${DEV_ENV:-} ]] || fail "DEV_ENV is not set"
	XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
	XDG_DATA_HOME=${XDG_DATA_HOME:-"$HOME/.local/share"}

	HOME=$(normalize_path "$HOME")
	XDG_CONFIG_HOME=$(normalize_path "$XDG_CONFIG_HOME")
	XDG_DATA_HOME=$(normalize_path "$XDG_DATA_HOME")
	DEV_ENV_ROOT=$(canonical_directory "$DEV_ENV")
	[[ $DEV_ENV_ROOT != / ]] || fail "DEV_ENV may not be /"
	source_directory_exists "$DEV_ENV_ROOT/env"
}

main() {
	parse_args "$@"
	initialize_paths
	log_action "source root: $DEV_ENV_ROOT"

	case $PROFILE in
	full)
		install_full_environment
		reload_login_shell
		;;
	container)
		install_pi_environment
		install_container_environment
		migrate_legacy_wt
		;;
	esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
