#!/usr/bin/env bash

set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null && pwd -P)
TEST_ROOT=$(mktemp -d)
trap 'rm -rf -- "$TEST_ROOT"' EXIT

pass_count=0

fail() {
	printf 'not ok - %s\n' "$*" >&2
	exit 1
}

assert_file_contains() {
	local file=$1 expected=$2
	[[ -f $file ]] || fail "missing file: $file"
	grep -Fq -- "$expected" "$file" || fail "$file does not contain: $expected"
}

assert_exists() {
	[[ -e $1 || -L $1 ]] || fail "expected path to exist: $1"
}

assert_absent() {
	[[ ! -e $1 && ! -L $1 ]] || fail "expected path to be absent: $1"
}

make_fixture() {
	local case_root=$1 source
	source=$case_root/source
	mkdir -p -- \
		"$source/env/.config/new [feature]" \
		"$source/env/.config/eza" \
		"$source/env/.config/git" \
		"$source/env/.config/ripgrep" \
		"$source/env/.config/starship" \
		"$source/env/.config/yazi" \
		"$source/env/.config/herdr" \
		"$source/env/.config/hypr" \
