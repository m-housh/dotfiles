make_stubs() {
	local case_root=$1 fake_bin
	fake_bin=$case_root/bin
	mkdir -p -- "$fake_bin"
	for command_name in mailctl systemctl hyprctl espanso zsh; do
		cat >"$fake_bin/$command_name" <<'EOF'
#!/usr/bin/env bash
printf '%s' "$(basename -- "$0")" >>"$INVOCATIONS"
printf ' <%s>' "$@" >>"$INVOCATIONS"
printf '\n' >>"$INVOCATIONS"
EOF
		chmod +x -- "$fake_bin/$command_name"
	done
	cat >"$fake_bin/podman" <<'EOF'
#!/usr/bin/env bash
printf '%s' "$(basename -- "$0")" >>"$INVOCATIONS"
printf ' <%s>' "$@" >>"$INVOCATIONS"
printf '\n' >>"$INVOCATIONS"
printf 'hpa completion\n'
EOF
	chmod +x -- "$fake_bin/podman"
	cat >"$fake_bin/git" <<'EOF'
#!/usr/bin/env bash
printf 'git' >>"$INVOCATIONS"
printf ' <%s>' "$@" >>"$INVOCATIONS"
printf '\n' >>"$INVOCATIONS"
EOF
	chmod +x -- "$fake_bin/git"
}

prepare_case() {
	local name=$1 case_root
	case_root="$TEST_ROOT/$name"
	mkdir -p -- "$case_root/home [test]" "$case_root/xdg config" "$case_root/xdg data"
	make_fixture "$case_root"
	make_stubs "$case_root"
	printf '%s\n' "$case_root"
}

run_installer() {
	local case_root=$1
	shift
	env \
		HOME="$case_root/home [test]" \
		XDG_CONFIG_HOME="$case_root/xdg config" \
		XDG_DATA_HOME="$case_root/xdg data" \
		DEV_ENV="$case_root/source" \
		INVOCATIONS="$case_root/invocations" \
		PATH="$case_root/bin:/usr/bin:/bin" \
		"$case_root/source/dev-env" "$@"
}

