	printf 'new hypr config\n' >"$source/env/.config/hypr/hyprland.lua"
	printf 'new nvim\n' >"$source/env/.config/nvim/init.lua"
	printf 'template\n' >"$source/env/.config/kanata/template.kbd"
	printf 'managed unit\n' >"$source/env/.config/systemd/user/managed.service"
	printf 'new function\n' >"$source/env/.config/zsh/functions/managed"
