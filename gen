#!/usr/bin/env bash

# Generates a new run manifest, webapp specification, or general script.

set -Eeuo pipefail
set -o noclobber

PROGRAM=${0##*/}
incomplete_destination=

after_exit() {
	local status=$?
	if ((status != 0)) && [[ -n $incomplete_destination ]]; then
		rm -f -- "$incomplete_destination"
	fi
}
trap after_exit EXIT

usage() {
	cat <<EOF
Usage:
  $PROGRAM run <name>
  $PROGRAM webapp <name>
  $PROGRAM script <name>

Generate a run manifest, webapp specification, or general Bash script under DEV_ENV.
EOF
}

fail() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
	exit 1
}

is_type() {
	case $1 in
		run | webapp | script) return 0 ;;
		*) return 1 ;;
	esac
}

is_within() {
	local child=$1 parent=${2%/}
	[[ $child == "$parent"/* ]]
}

validate_name() {
	local type=$1 name=$2

	[[ -n $name ]] || fail 'destination name must not be empty'
	[[ $name != /* ]] || fail "destination name must be relative: $name"
	[[ $name != */ && $name != *//* ]] || fail "destination name contains an empty path component: $name"
	case "/$name/" in
		*/./* | */../*) fail "destination name must not contain '.' or '..' components: $name" ;;
	esac
	if [[ $type != script && $name == */* ]]; then
		fail "$type destination must be a single file name: $name"
	fi
}

write_run() {
	cat >"$destination" <<'EOF'
# Packages to install / uninstall with this run.
EOF
	chmod 0644 -- "$destination"
}

write_webapp() {
	cat >"$destination" <<'EOF'
{
  "name": "My App",
  "url": "https://example.com",
  "icon": "https://icon.com"
}
EOF
	chmod 0644 -- "$destination"
}

write_script() {
	cat >"$destination" <<'EOF'
#!/usr/bin/env bash

set -e
set -o nounset
set -o pipefail

SCRIPTS=${SCRIPTS:-$HOME/.local/scripts}
THIS_FILE=${BASH_SOURCE[0]}
LOG_LABEL=$(basename "$THIS_FILE")
THIS=${THIS:-$LOG_LABEL}
LOG_FILE=${LOG_FILE:-"$LOG_LABEL.log"}

# Logging utility function, use in place of echo.
log() {
  logging log --source "$THIS_FILE" "$@"
}

################################################################################
# MAIN
################################################################################

# Setup logging file and label.
source "$SCRIPTS/hypr/logging"
setup-logging "$LOG_FILE" "$LOG_LABEL"

log "Starting $THIS..."

EOF
	chmod 0755 -- "$destination"
}

if (($# == 1)) && [[ $1 == --help ]]; then
	usage
	exit 0
fi

(($# > 0)) || fail 'generation type and destination name are required (try --help)'
if ! is_type "$1"; then
	fail "unknown generation type: $1"
fi
(($# > 1)) || fail "destination name is required for $1"
(($# == 2)) || fail 'expected exactly one generation type and one destination name; extra arguments supplied'
if is_type "$2"; then
	fail 'multiple generation types are not allowed'
fi

type=$1
name=$2
validate_name "$type" "$name"

[[ -n ${DEV_ENV:-} ]] || fail 'env var DEV_ENV needs to be present'
[[ -d $DEV_ENV ]] || fail "DEV_ENV is not a directory: $DEV_ENV"
dev_env=$(cd -- "$DEV_ENV" >/dev/null && pwd -P)

case $type in
	run)
		root=$dev_env/runs
		;;
	webapp)
		root=$dev_env/env/webapps
		[[ $name == *.json ]] || name+=.json
		;;
	script)
		root=$dev_env/env/.local/scripts
		;;
esac

canonical_root=$(realpath -m -- "$root")
is_within "$canonical_root" "$dev_env" || fail "$type destination root is outside DEV_ENV: $root"

destination=$root/$name
canonical_destination=$(realpath -m -- "$destination")
is_within "$canonical_destination" "$canonical_root" || fail "destination is outside the $type root: $name"

if [[ -e $destination || -L $destination ]]; then
	fail "destination already exists: $destination"
fi

# All request validation is complete before any directories or files are made.
mkdir -p -- "${destination%/*}"
printf 'Creating new %s: %s\n' "$type" "$destination"
incomplete_destination=$destination
case $type in
	run) write_run ;;
	webapp) write_webapp ;;
	script) write_script ;;
esac
incomplete_destination=
