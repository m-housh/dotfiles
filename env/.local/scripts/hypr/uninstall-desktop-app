#!/usr/bin/env bash

set -Eeuo pipefail

THIS_FILE=${BASH_SOURCE[0]}
THIS=$(basename -- "$THIS_FILE")

usage() {
  cat <<EOF

Uninstalls '.desktop' files and safe managed icon files. Most commonly
used for web applications; if an application was installed by a
package manager, then it should be used to uninstall the application.

Usage:

  $ $THIS [OPTIONS] [FILE...]

OPTIONS:

  --dry-run:    Perform but don't actually remove anything.
  -h | --help:  Show the help page.

If no files are supplied, then an interactive session will be
started that allows you to choose the applications to remove.

EOF
}

declare -a files=()
interactive_mode="0"
dry_run="0"
XDG_DATA_HOME=${XDG_DATA_HOME:-}
SCRIPTS=${SCRIPTS:-$HOME/.local/scripts}

while [[ $# -gt 0 ]]; do
  if [[ $1 =~ ^--dry ]]; then
    dry_run="1"
  elif [[ $1 =~ ^-h ]] || [[ $1 =~ ^--h ]]; then
    usage
    exit 0
  else
    files+=("$1")
  fi
  shift
done

log() {
  logging log --source "$THIS_FILE" "$@"
}

validate_managed_name() {
  local label=$1 value=$2
  if [[ -z $value || $value == "." || $value == ".." || $value == */* || $value == *\\* || $value =~ [[:cntrl:]] ]]; then
    log --error "Unsafe $label: '$value'."
    return 1
  fi
}

name_from_spec() {
  local spec=$1
  if [[ ! -f $spec ]] || ! jq -e '
    def plain_string: type == "string" and all(explode[]; . >= 32 and . != 127);
    type == "object" and (.name | plain_string)
  ' "$spec" >/dev/null 2>&1; then
    log --error "Invalid or unreadable webapp JSON: '$spec'."
    return 1
  fi
  jq -r '.name' "$spec"
}

safe_managed_icon() {
  local icon=$1 icon_root target

  [[ $icon != *[[:cntrl:]]* && $icon == /* && -f $icon && ! -L $icon ]] || return 1
  icon_root=$(realpath -e -- "$XDG_DATA_HOME/applications/icons") || return 1
  target=$(realpath -e -- "$icon") || return 1
  [[ $target == "$icon_root/"* ]]
}

############################## MAIN ##############################

# shellcheck source=/dev/null
source "$SCRIPTS/hypr/logging"
setup-logging "$THIS.log" "$THIS"
export LOG_ENABLE_DRY_RUN="$dry_run"

if [[ -z $XDG_DATA_HOME ]]; then
  log "xdg data home is not set"
  log "using: ~/.local/share"
  XDG_DATA_HOME=$HOME/.local/share
fi

if [[ ${#files[@]} -eq 0 ]]; then
  interactive_mode="1"
  mapfile -t files < <(
    find "$XDG_DATA_HOME/applications" -mindepth 1 -maxdepth 1 -type f -name "*.desktop" -printf "%f\n" |
      gum choose --no-limit --padding "2 4" --header "Choose desktop apps to remove:" --selected-prefix="✗ "
  )
fi

removed_desktop="0"
for argument in "${files[@]}"; do
  f=$argument
  log "ARG: $f"

  if [[ $f == *.json ]]; then
    if ! name=$(name_from_spec "$f"); then
      exit 1
    fi
    if ! validate_managed_name "application name" "$name"; then
      exit 1
    fi
    fname="$name.desktop"
  else
    if ! validate_managed_name "desktop filename" "$f" || [[ $f != *.desktop ]]; then
      log --error "Invalid desktop filename: '$f'."
      exit 1
    fi
    fname=$f
  fi

  log "Uninstalling Desktop: $fname"
  file="$XDG_DATA_HOME/applications/$fname"

  if [[ ! -f $file ]]; then
    log "[WARNING]: File didn't exist, skipping!"
    continue
  fi
  if [[ -L $file ]]; then
    log "[WARNING]: Desktop target is a symlink, preserving: $file"
    continue
  fi

  icon_line=$(grep -m 1 '^Icon=' "$file" || true)
  icon=${icon_line#Icon=}

  if [[ -n $icon ]]; then
    if safe_managed_icon "$icon"; then
      log "   removing managed icon: rm -f $icon"
      if [[ $dry_run == "0" ]]; then
        rm -f -- "$icon"
      fi
    else
      log "[WARNING]: Preserving unsafe or unmanaged icon target: $icon"
    fi
  fi
  log "   removing desktop: rm -f $file"

  if [[ $dry_run == "0" ]] && rm -f -- "$file"; then
    removed_desktop="1"
  fi
done

if [[ $dry_run == "0" && $removed_desktop == "1" ]]; then
  update-desktop-database "$XDG_DATA_HOME/applications"

  if [[ $interactive_mode == "1" ]]; then
    log "Done!"
  fi
fi
