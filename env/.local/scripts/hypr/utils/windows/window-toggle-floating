#!/usr/bin/env bash

set -e
set -o nounset
set -o pipefail

SCRIPTS=${SCRIPTS:-$HOME/.local/scripts}
THIS_FILE=${BASH_SOURCE[0]}
LOG_LABEL=$(basename "$THIS_FILE")
THIS=${THIS:-$LOG_LABEL}
LOG_FILE=${LOG_FILE:-"$LOG_LABEL.log"}

address=""
width=""
height=""

usage() {
  cat <<EOF

Utility for toggling a windows floating property.

If no address is supplied and '--active' flag is not set, then we will read address from stdin.

USAGE:

  $ $THIS <flags> <address>

FLAGS:
  -a | --active:        Toggles floating of the active window.
  -w | --width <n>:     Set a width of the floating window, can be pixels or percent (ex. 80%).
  -h | --height <n>:    Set a height of the floating window, can be pixels or percent (ex. 80%).
  --help:               Show this help page.

EOF

}

log() {
  logging log --source "$THIS_FILE" "$@"
}

lua_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

window_monitor_size() {
  local address=$1
  local field=$2
  local monitor_id
  monitor_id=$(hyprctl clients -j | jq -r --arg address "$address" '.[] | select(.address == $address) | .monitor')
  hyprctl monitors -j | jq -r --argjson id "$monitor_id" --arg field "$field" '.[] | select(.id == $id) | .[$field]'
}

resolve_size() {
  local value=$1
  local address=$2
  local dimension=$3
  if [[ $value == *% ]]; then
    local percent=${value%%%}
    local base
    base=$(window_monitor_size "$address" "$dimension")
    awk -v base="$base" -v percent="$percent" 'BEGIN { printf "%d", base * percent / 100 }'
  else
    printf '%s' "$value"
  fi
}

toggle_floating() {
  hyprctl dispatch "hl.dsp.window.float({ action = \"toggle\", window = $(lua_quote "address:$address") })" >/dev/null 2>&1
}

resize_window() {
  if [[ -n $width ]] && [[ -n $height ]]; then
    log "Resizing window: width: $width, height: $height"
    local resolved_width resolved_height
    resolved_width=$(resolve_size "$width" "$address" width)
    resolved_height=$(resolve_size "$height" "$address" height)
    hyprctl dispatch "hl.dsp.window.resize({ x = $resolved_width, y = $resolved_height, exact = true, window = $(lua_quote "address:$address") })" >/dev/null 2>&1
  fi

  echo "$address"

}

center_window() {
  local address=""
  read -r address
  local activeaddress=$(hyprctl activewindow -j | jq -r '.address')
  if [[ $address == $activeaddress ]]; then
    log "Centering window..."
    hyprctl dispatch "hl.dsp.window.center()" >/dev/null 2>&1
  fi
}

################################################################################
# MAIN
################################################################################

# Setup logging
source "$SCRIPTS/hypr/logging"
setup-logging "$LOG_FILE" "$LOG_LABEL"

while [[ $# -gt 0 ]]; do
  if [[ $1 == "--help" ]]; then
    usage && exit 0
  elif [[ $1 == "-w" ]] || [[ $1 == "--width" ]]; then
    shift
    width=$1
  elif [[ $1 == "-h" ]] || [[ $1 == "--height" ]]; then
    shift
    height=$1
  elif [[ $1 == "-a" ]] || [[ $1 == "--active" ]]; then
    address=$(hyprctl activewindow -j | jq -r '.address')
  else
    address=$1
  fi
  shift
done

if [[ -z $address ]]; then
  read -p "Window address: " address
fi

if [[ -z $address ]]; then
  log --error "No address was supplied" && exit 1
fi

log "Begin toggling floating for: '$address'"

floating=$(hyprctl clients -j | jq ".[] | select(.address == \"$address\") | .floating")
log "Is currently floating: $floating"

toggle_floating

if [ ! "$floating" == "true" ]; then
  resize_window | center_window
fi
